# ---------------------------------------------------------------
# Homestead Interiors — environment variables
# Copy to .env.local for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# Public URL of the live site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Content preview mode.
#   "true"  (default) → draft services, sample portfolio and placeholder sections are shown,
#                        each clearly labelled as draft / sample.
#   "false"            → only content marked as confirmed is published. Use this for launch.
NEXT_PUBLIC_CONTENT_PREVIEW=true

# Enquiries go to WhatsApp (+91 99230 83668, set in src/lib/site.ts) — no keys needed.
